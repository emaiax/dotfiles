{
  "commands": {
    "allow": [
      "cat",
      "chmod",
      "command",
      "echo",
      "find",
      "fj",
      "git",
      "grep",
      "head",
      "jq",
      "just",
      "ls",
      "nix",
      "readlink",
      "rg",
      "rtk",
      "sort",
      "ssh -o ProxyCommand=",
      "tail",
      "which"
    ],
    "ask": [
      "git push",
      "python3",
      "rm -rf"
    ],
    "askExact": [
      "git checkout ."
    ],
    "bypassSandboxSeatbelt": [
      "docker *",
      "rtk docker *",
      "gh *",
      "rtk gh *",
      "fj *",
      "rtk fj *",
      "ssh *",
      "rtk ssh *"
    ],
    "deny": [
      "gh pr close",
      "gh pr comment",
      "gh pr create",
      "gh pr merge",
      "gh issue close",
      "gh issue comment",
      "gh issue create",
      "gh issue edit"
    ],
    "denySoft": [
      "fj issue create",
      "fj issue edit",
      "fj issue comment"
    ],
    "extraAllow": [],
    "extraAsk": [],
    "extraDeny": []
  },
  "filesystem": {
