{
  "altScreenMode": "always",
  "artifactReviewPolicy": "agent-decides",
  "colorScheme": "tokyo night",
  "enableTelemetry": false,
  "permissions": {
    "allow": [
      "command(cat *)",
      "command(chmod *)",
      "command(command *)",
      "command(docker *)",
      "command(find *)",
      "command(fj *)",
      "command(git *)",
      "command(grep *)",
      "command(jq *)",
      "command(just *)",
      "command(ls *)",
      "command(nix *)",
      "command(rg *)",
      "command(rtk *)",
      "command(ssh -o ProxyCommand=)",
      "command(tail *)",
      "command(gh --help *)",
      "command(gh --version *)",
      "command(gh help *)",
      "command(gh browse *)",
      "command(gh search *)",
      "command(gh status *)",
      "command(gh cache list *)",
      "command(gh label list *)",
      "command(gh org list *)",
      "command(gh config get *)",
      "command(gh config list *)",
      "command(gh discussion list *)",
      "command(gh discussion view *)",
      "command(gh gist list *)",
      "command(gh gist view *)",
      "command(gh issue list *)",
      "command(gh issue status *)",
      "command(gh issue view *)",
      "command(gh pr checks *)",
      "command(gh pr diff *)",
      "command(gh pr list *)",
      "command(gh pr status *)",
      "command(gh pr view *)",
      "command(gh project field-list *)",
      "command(gh project item-list *)",
      "command(gh project list *)",
      "command(gh project view *)",
      "command(gh release list *)",
      "command(gh release view *)",
      "command(gh repo list *)",
      "command(gh repo view *)",
      "command(gh ruleset check *)",
      "command(gh ruleset list *)",
      "command(gh ruleset view *)",
      "command(gh run list *)",
      "command(gh run view *)",
      "command(gh run watch *)",
      "command(gh variable get *)",
      "command(gh variable list *)",
      "command(gh workflow list *)",
      "command(gh workflow view *)"
    ],
    "ask": [
      "command(docker prune *)",
      "command(gh workflow run *)",
      "command(gh repo clone *)",
      "command(git clone *)",
      "command(git push *)",
      "command(python3 *)",
      "command(rm -rf *)",
      "command(git checkout .)"
    ],
    "deny": [
      "command(gh pr close *)",
      "command(gh pr comment *)",
      "command(gh pr create *)",
      "command(gh pr edit *)",
      "command(gh pr merge *)",
      "command(gh issue close *)",
      "command(gh issue comment *)",
      "command(gh issue create *)",
      "command(gh issue edit *)"
    ]
  },
  "showFeedbackSurvey": false,
  "toolPermission": "always-proceed",
  "verbosity": "low"
}
