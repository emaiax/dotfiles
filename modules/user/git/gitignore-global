# general.gitignore
#
# git only reads `#` as a comment at the start of a line, so comments go on their own line
#
# backup files
*~
.git

# environment files loaded by dotenv. .envrc and the committed samples stay visible
.env
.env.*
!.env.example
!.env.sample

node_modules/

# git worktrees, one per branch at <repo>/.worktrees/<name>
#
.worktrees/

# per-project cache written by direnv and nix-direnv
.direnv/

# macos.gitignore
#
# general
#
# thumbnails
._*
.AppleDouble
.DS_Store
.LSOverride
# the file is named Icon followed by two carriage returns
Icon

# files that might appear in the root of a volume
#
.com.apple.timemachine.donotpresent
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns

# directories potentially created on remote AFP share
#
.apdisk
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items

# linux.gitignore
#
# .nfs files created when an open file is deleted but still in use
.nfs*
# trash folder that may appear on any partition or disk
.Trash-*

# vim.gitignore
#
# persistent undo
[._]*.un~
# swap files
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]

# elixir.gitignore
#
# elixir lsp config/version files
.elixir_ls/
# archive artifacts built via "mix archive.build"
*.beam
*.ez
# beam/OTP crash dumps
erl_crash.dump
