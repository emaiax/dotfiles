# general.gitignore
#
*~             # backup files
.env*          # ignore environment files (loaded by dotenv)
sandbox/       # ignore all sandbox folders
vendor/        # dependency directories
node_modules/  # fuck node_modules

# macos.gitignore
#
# general
#
._*  # thumbnails
.AppleDouble
.DS_Store
.LSOverride
Icon # icon must end with two \r

# files that might appear in the root of a volume
#
.com.apple.timemachine.donotpresent
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns

# directories potentially created on remote AFP share
#
.apdisk
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items

# linux.gitignore
#
.nfs*     # .nfs files created when an open file is deleted but still in use
.Trash-*  # linux trash folder that may appear on any partition or disk

# vim.gitignore
#
[._]*.un~          # persistent undo
[._]*.s[a-v][a-z]  # swap files
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]

# elixir.gitignore
#
.elixir_ls/     # elixir lsp config/version files
*.beam          # ignore archive artifacts (built via "mix archive.build").
*.ez
erl_crash.dump  # ignore beam/OTP crash dump files
