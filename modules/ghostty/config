# vi:ft=conf
#
# https://ghostty.org/docs/config/reference
#
auto-update-channel = tip
clipboard-paste-protection = false
clipboard-read = "allow"
confirm-close-surface = true
cursor-style = block
cursor-style-blink = true
mouse-hide-while-typing = true
shell-integration = none

# maximizes the window
#
window-decoration = true
window-height = 9999
window-padding-balance = true
window-save-state = always
window-width = 9999

# macos
#
macos-option-as-alt = true
macos-titlebar-style = "tabs"

# fixes GruvboxDarkHard https://github.com/mbadolato/iTerm2-Color-Schemes/commit/506ab2b98b6546d1dc46327dfa1e1e3f8363fbc0
#
background = "#1b1b1b"
palette = "0=#1b1b1b"
theme = GruvboxDarkHard
window-theme = "dark"

# fonts and ligatures
#
font-family = "tx-02"
font-feature = calt
font-feature = liga
font-feature = zero
font-size = 12

# powerline & powerline-extras https://github.com/ryanoasis/nerd-fonts/wiki/Glyph-Sets-and-Code-Points
#
font-codepoint-map = U+e0b0-U+e0b3,U+e0b4-U+e0c8,U+e0cc-U+e0d4,U+e0ca=JetBrainsMono Nerd Font Mono

# font-awesome
#
font-codepoint-map = U+f000-U+f2e0,U+e200-U+e2a9=JetBrainsMono Nerd Font Mono

# seti-ui
#
font-codepoint-map = U+e5fa-U+e6b1=JetBrainsMono Nerd Font Mono

# codicons
#
font-codepoint-map = U+ea60-U+ebeb=JetBrainsMono Nerd Font Mono -->
