{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "automerge": false,
  "nix": {
    "enabled": true,
    "lockFileMaintenance": {
      "enabled": true,
      "schedule": ["* 2 * * *"]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^modules/user/apps/claudio/claude-code/default\\.nix$/"],
      "matchStrings": ["claudeMemVersion = \"(?<currentValue>[^\"]+)\";"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "thedotmack/claude-mem"
    }
  ]
}
